# ============================================
# Variables de entorno — Portafolio Julio Cesar
# ============================================
# Copia este archivo a .env y completa el valor.
#
# Solo hay una variable, y es opcional. El resto de datos (usuario de GitHub,
# enlaces, email) viven en el código, que para un portfolio personal es más
# simple de seguir que repartirlos entre .env y el repo.

# ============================================
# Formspree — formulario de contacto
# ============================================
# Sin esto se usa el endpoint que ya está en src/components/Contact.tsx.
# Para usar el tuyo:
#   1. Crea una cuenta en https://formspree.io
#   2. Crea un formulario nuevo
#   3. Pega aquí el endpoint que te den
VITE_FORMSPREE_URL=https://formspree.io/f/TU_ID_AQUI
